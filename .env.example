# Optional. Without these the app runs fully offline and feedback opens a GitHub issue.
# With them, feedback is saved to Supabase (see supabase/migrations).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# When Supabase is configured, learners must sign in before using the course.
# Set to "false" to make accounts optional (course open to everyone, sign-in only for sync).
NEXT_PUBLIC_REQUIRE_LOGIN=
